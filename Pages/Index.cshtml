@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to My Music Showcase</h1>
    <p>Check out my favorite song and dynamic animation below!</p>
</div>

<!-- JavaScript Animation Section -->
<section class="animation-section my-4 text-center">
    <h2>JavaScript Animation Example</h2>
    <div id="animationContainer">
        <div id="animateBox"></div>
    </div>
    <button class="btn btn-primary mt-2" onclick="startAnimation()">Start Animation</button>
</section>

<!-- YouTube Video Section -->
<section class="video-section my-4 text-center">
    <h2>Featured Song</h2>
    <div class="video-wrapper">
        <!-- Replace dQw4w9WgXcQ with your preferred YouTube Video ID -->
        <iframe width="560"
                height="315"
                src="https://www.youtube.com/embed/dQw4w9WgXcQ"
                title="YouTube video player"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen>
        </iframe>
    </div>
</section>